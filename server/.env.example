# ================================================================
# AXELON server configuration — copy to server/.env (NEVER commit .env)
# On cPanel you can instead add these as "Environment variables" in
# Setup Node.js App. In production the server refuses to start if any
# required value is missing or weak.
# ================================================================

NODE_ENV=production
PORT=5000

# Your live site address (no trailing slash)
PUBLIC_ORIGIN=https://yourdomain.com
# Optional extra origins allowed to call the API, comma-separated (usually leave empty)
ALLOWED_ORIGINS=

# --- Secrets: generate each with ---
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use DIFFERENT values for each. Never reuse the examples.
JWT_SECRET=CHANGE_ME
ENCRYPTION_MASTER_KEY=CHANGE_ME
# !! Back up ENCRYPTION_MASTER_KEY somewhere safe. If you lose it, the
# !! encrypted data vault and uploaded files cannot be recovered.

# --- Master admin (password is only used the very first time the server starts) ---
ADMIN_FULL_NAME=Your Admin Name
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=01XXXXXXXXX
ADMIN_ADDRESS=Your Store Address
ADMIN_PASSWORD=

# --- Email (verification + password reset codes) ---
# FREE option 1 (recommended): an email account created in cPanel → Email Accounts
#   SMTP_HOST=mail.yourdomain.com   SMTP_PORT=465   SMTP_USER=noreply@yourdomain.com
# FREE option 2: Gmail with an App Password (500 emails/day)
#   SMTP_HOST=smtp.gmail.com        SMTP_PORT=465   SMTP_USER=you@gmail.com
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=
MAIL_FROM="AXELON <noreply@yourdomain.com>"

# --- Optional ---
# MongoDB backup copy of the encrypted vault (e.g. free MongoDB Atlas). Leave empty to disable.
MONGO_URI=
# Max upload size in MB for chat files (product photos use the same limit)
MAX_UPLOAD_MB=100
# Reverse-proxy trust. 'loopback' is correct for cPanel/Passenger. Don't change unless you know why.
TRUST_PROXY=loopback
